# crontab snippet for the DO droplet.
#
# 1. Place the repo at /opt/hltv-parser-ver1 (or change REPO below).
# 2. Make sure /opt/hltv-parser-ver1/.env exists and contains
#    PANDASCORE_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE.
# 3. `crontab -e` and paste the lines below.
# 4. Verify with `crontab -l`.
#
# Logs land in /opt/hltv-parser-ver1/logs/<scraper>.log — tail with:
#     tail -f /opt/hltv-parser-ver1/logs/pandascore.log
#
# Times are in the droplet's local timezone unless you set CRON_TZ.
# The line below pins everything to UTC so 02:00 UTC really is 02:00 UTC.

CRON_TZ=UTC
REPO=/opt/hltv-parser-ver1

# pandascore run — every 6 hours on the hour (00:00, 06:00, 12:00, 18:00 UTC)
0 */6 * * *   $REPO/scripts/run_scraper.sh pandascore run

# steam refresh — daily at 02:00 UTC (low-traffic window for Steam)
0  2  * * *   $REPO/scripts/run_scraper.sh steam refresh
