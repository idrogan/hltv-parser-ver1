# Bearer token required on every API request. Leave empty to disable auth.
API_TOKEN=change-me

# uvicorn / FastAPI logging level
LOG_LEVEL=INFO

# --- HLTV -------------------------------------------------------------------
# Minimum seconds between HLTV requests. Below ~1.5s the WAF will block you.
HLTV_MIN_DELAY=2.0
# Optional outbound proxy for HLTV, e.g. http://user:pass@host:port
HLTV_PROXY=

# --- Steam Market -----------------------------------------------------------
# Valve rate-limits hard; 3.5s is safe for background workers.
STEAM_MIN_DELAY=3.5
STEAM_PROXY=
# Optional: value of the ``steamLoginSecure`` cookie from a logged-in
# browser session. Only needed for /steam/history (full per-sale history).
# Grab it via DevTools -> Application -> Cookies on steamcommunity.com.
STEAM_LOGIN_SECURE=

# --- EsportsCharts ----------------------------------------------------------
ESCHARTS_MIN_DELAY=2.0
ESCHARTS_PROXY=
