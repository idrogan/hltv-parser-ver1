# =============================================================================
#  esports-data-api  —  parser-only environment file
# =============================================================================
# Copy to .env and fill in the values. n8n Cloud, Supabase, Telegram and
# Anthropic credentials are configured in n8n Cloud's UI (Settings →
# Variables / Credentials) — they do NOT belong in this file.

# -----------------------------------------------------------------------------
#  Required
# -----------------------------------------------------------------------------

# Bearer token guarding every non-meta route.
# Generate:   openssl rand -hex 16
API_TOKEN=

# Refuse to start when API_TOKEN is empty. Always "true" in production.
# Set "false" only when you knowingly want an open API on a private LAN.
API_REQUIRE_TOKEN=true

# -----------------------------------------------------------------------------
#  Server
# -----------------------------------------------------------------------------

# Render injects $PORT automatically. Leave 8000 for local dev.
PORT=8000

LOG_LEVEL=INFO

# Per-IP request budget enforced by slowapi.
RATE_LIMIT_PER_MINUTE=60

# Lock to your n8n Cloud origin in production, e.g.
# https://your-tenant.app.n8n.cloud
ALLOWED_ORIGIN=*

# -----------------------------------------------------------------------------
#  Feature flags
# -----------------------------------------------------------------------------

# HLTV is paused (May 2026) until paid Cloudflare-bypass budget is available.
# Default false. With HLTV_ENABLED=false, every HLTV entry point (FastAPI
# router, CLI, service methods) short-circuits and returns / raises a
# structured "hltv_paused" error. Code paths stay in the repo.
HLTV_ENABLED=false

# -----------------------------------------------------------------------------
#  Upstream scraper throttles  (lower = faster + more likely to be blocked)
# -----------------------------------------------------------------------------
HLTV_MIN_DELAY=2.0
STEAM_MIN_DELAY=3.5
ESCHARTS_MIN_DELAY=2.0

# -----------------------------------------------------------------------------
#  Optional
# -----------------------------------------------------------------------------

# Outbound residential proxies (URL form: http://user:pass@host:port).
HLTV_PROXY=
STEAM_PROXY=
ESCHARTS_PROXY=

# Cookie value from a logged-in steamcommunity.com session. Only needed
# for /steam/history (full per-sale history). DevTools → Application →
# Cookies → steamLoginSecure.
STEAM_LOGIN_SECURE=

# -----------------------------------------------------------------------------
#  Supabase  (required for any scraper that writes to Postgres)
# -----------------------------------------------------------------------------

# https://<project-ref>.supabase.co  — from Supabase → Project Settings → API.
SUPABASE_URL=

# Service-role key. Bypasses RLS — treat as a top-tier secret. Get it
# from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE=

# -----------------------------------------------------------------------------
#  Liquipedia  (required by their API TOS for the User-Agent contact)
# -----------------------------------------------------------------------------

# Goes into the User-Agent: "<project>/<ver> (<url>; <email>)". Liquipedia
# blocks generic UAs. Use a real address you can be reached at.
LIQUIPEDIA_CONTACT_EMAIL=

# Optional: project URL injected into the same User-Agent string.
LIQUIPEDIA_PROJECT_URL=https://github.com/idrogan/hltv-parser-ver1

# Optional: throttle floor in seconds. Hard floor is 2.0 (TOS); raising
# it is fine, lowering is ignored.
LIQUIPEDIA_MIN_DELAY=2.0

# Optional: where the per-day response cache lives.
LIQUIPEDIA_CACHE_DIR=.cache/liquipedia

# Required for structured cargoquery access. The public MediaWiki API
# does NOT expose action=cargoquery. Apply at https://api.liquipedia.net/
# — free tier is 60 requests/hour. Credentials granted on approval;
# documentation is behind the LiquipediaDB Dashboard login.
LIQUIPEDIA_API_KEY=

# -----------------------------------------------------------------------------
#  PandaScore  (required for the PandaScore parser)
# -----------------------------------------------------------------------------

# https://app.pandascore.co → Account → API token.
PANDASCORE_API_KEY=
