# =============================================================================
#  cs2-dashboard backend — environment file
# =============================================================================
# Copy to backend/.env and fill in the values.

# --- Auth ---------------------------------------------------------------------
# Shared bearer token guarding every /api/* route (except /api/health).
# Generate: openssl rand -hex 16
DASHBOARD_API_TOKEN=

# Password for the single-user frontend login.
DASHBOARD_LOGIN_PASSWORD=

# --- Supabase (same project as the pipeline) ----------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE=

# --- Pipeline integration -----------------------------------------------------
# Absolute path to the pipeline repo checkout, used to shell out to its CLI.
PIPELINE_REPO_PATH=/opt/hltv-parser-ver1

# --- Server -------------------------------------------------------------------
PORT=8001
LOG_LEVEL=INFO

# Lock to the dashboard frontend origin in production, e.g.
# https://dashboard.your-domain.com
ALLOWED_ORIGIN=*
